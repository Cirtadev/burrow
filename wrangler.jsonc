// The website (site/) as a Cloudflare Worker with static assets only; Workers Builds deploys it from master
// with `npx wrangler deploy`. site/_headers sets its headers, site/404.html answers unknown paths.
// Its custom domain, burrow.cirta.dev, is attached in the dashboard.
{
  "name": "burrow",
  "compatibility_date": "2026-11-04",
  // Only burrow.cirta.dev: no workers.dev address, no preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Workers Logs and metrics on the dashboard.
  "observability": {
    "enabled": true
  }
}
